# Временный домен для TV-борда без покупки/настройки DNS — через nip.io,
# бесплатный wildcard-сервис: любое имя вида "что-угодно.<IP-через-дефисы>.nip.io"
# резолвится прямо в ваш IP. Замените SERVER_IP_DASHED ниже на публичный IP
# сервера, где точки заменены на дефисы (например, 203.0.113.5 -> 203-0-113-5).
server {
    listen 80;
    server_name tvboard.SERVER_IP_DASHED.nip.io;

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
