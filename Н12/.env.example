# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
# .env никогда не коммитится в git (см. .gitignore).

# Токен бота из @BotFather
BOT_TOKEN=

# Telegram ID через запятую. ADMIN_IDS — только «Установить время».
# SUPER_ADMIN_IDS — полный административный доступ (заявки, финансы, рассылки).
ADMIN_IDS=
SUPER_ADMIN_IDS=

# Публичный HTTPS-адрес Mini App. Без него кнопка «🚀 Открыть VALEVO» не
# появится в меню бота. Должен совпадать с адресом, указанным в @BotFather.
WEBAPP_URL=https://valevo.club

# YCLIENTS
YCLIENTS_COMPANY_ID=
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_USER_TOKEN=
YCLIENTS_LOYALTY_CARD_TYPE_ID=

# Необязательные настройки — можно не трогать, есть значения по умолчанию.
# GROUP_ID=
# REFERRAL_BONUS_RUB=350
# MOSCOW_TZ=Europe/Moscow
# ENVIRONMENT=production
