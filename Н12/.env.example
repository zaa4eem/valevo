BOT_TOKEN=123456789:REPLACE_WITH_REAL_BOT_TOKEN
ADMIN_IDS=111111111,222222222
SUPPORT_CHAT_ID=111111111
GROUP_ID=0
MENU_VERSION=4

# ВАЖНО: на клубном ПК не перезаписывай существующий valevo.db.
DB_NAME=valevo.db
DATA_DIR=.
LOG_DIR=logs
BACKUP_DIR=backups

YCLIENTS_COMPANY_ID=REPLACE_WITH_YCLIENTS_COMPANY_ID
YCLIENTS_PARTNER_TOKEN=REPLACE_WITH_YCLIENTS_PARTNER_TOKEN
YCLIENTS_USER_TOKEN=REPLACE_WITH_YCLIENTS_USER_TOKEN

# Valevo Bonus / карта лояльности для начисления cashback победителям сезона.
YCLIENTS_LOYALTY_CARD_TYPE_ID=REPLACE_WITH_LOYALTY_CARD_TYPE_ID
YCLIENTS_BONUS_RUB_PER_HOUR=1000
YCLIENTS_ISSUE_CASHBACK=1

MOSCOW_TZ=Europe/Moscow
ENVIRONMENT=production

# Автоматизация YCLIENTS / Valevo Bonus
YCLIENTS_AUTO_SYNC=1
YCLIENTS_AUTO_CREATE_LOYALTY_CARDS=1
YCLIENTS_SYNC_ON_STARTUP=1
YCLIENTS_SYNC_INTERVAL_MINUTES=360
YCLIENTS_CARD_RETRY_INTERVAL_MINUTES=360
SEASON_BONUS_EXPIRE_DAYS=30
REFERRAL_BONUS_RUB=250

# Telegram Mini App (webapp/, см. deploy/WEBAPP_DEPLOY.md).
# Обязательно настоящий https-домен — самоподписанный сертификат Telegram не примет.
# Мини-апп и ТВ-табло разведены по поддоменам одного домена (не по путям —
# оба приложения считают, что работают в корне сайта), см.
# deploy/PORTAINER_DEPLOY.md.
WEBAPP_BASE_URL=https://app.valivo.online
WEBAPP_PORT=8020

# Только для деплоя через deploy/docker-compose.proxy.yml (nginx-proxy +
# acme-companion) — см. deploy/PORTAINER_DEPLOY.md. *_DOMAIN — голый домен
# без https:// (nginx-proxy сам матчит по Host-заголовку). WEBAPP_DOMAIN
# должен совпадать с доменом в WEBAPP_BASE_URL выше. LETSENCRYPT_EMAIL —
# куда придут уведомления об истечении сертификата, если автопродление
# сломается (общий для обоих доменов).
WEBAPP_DOMAIN=app.valivo.online
TVBOARD_DOMAIN=board.valivo.online
LETSENCRYPT_EMAIL=REPLACE_WITH_YOUR_EMAIL
