# Copy to infra/.env and fill in real values before running docker compose.
# NEVER commit the filled-in .env file (it's gitignored).

# --- Database ---
POSTGRES_USER=zaa4eem
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zaa4eem
DATABASE_URL=postgresql://zaa4eem:change-me@postgres:5432/zaa4eem

# --- Auth secrets (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# --- Telegram ---
# From @BotFather. NEVER commit the real value.
TELEGRAM_BOT_TOKEN=change-me
# Public HTTPS origin(s) of apps/web. Comma-separated if you serve both the
# apex and www — the API's CORS check accepts any of these as the browser
# Origin header.
WEB_ORIGIN=https://zaa4eem.ru,https://www.zaa4eem.ru
# Single canonical URL for the Telegram Mini App button (apps/bot) — must be
# exactly one URL, unlike WEB_ORIGIN above.
MINI_APP_URL=https://zaa4eem.ru
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# --- Frontend → API wiring ---
# The API lives on its own subdomain (see nginx-proxy routing below).
NEXT_PUBLIC_API_URL=https://api.zaa4eem.ru/api
# Same API host, but without the /api prefix — used server-side to build
# absolute URLs for uploaded files (e.g. avatars), which are served at
# /uploads/... rather than under /api.
API_PUBLIC_URL=https://api.zaa4eem.ru

# --- nginx-proxy / acme-companion (existing reverse proxy on this VPS) ---
# Docker network name the existing `nginx-proxy` + `nginx-proxy-acme`
# containers are attached to — check with:
#   docker inspect nginx-proxy --format '{{json .NetworkSettings.Networks}}'
NGINX_PROXY_NETWORK=proxy
# Host(s) nginx-proxy should route to the `web` container. Comma-separated
# for apex + www; acme-companion will request one certificate covering both.
WEB_VIRTUAL_HOST=zaa4eem.ru,www.zaa4eem.ru
# Host nginx-proxy should route to the `api` container.
API_VIRTUAL_HOST=api.zaa4eem.ru
# Real email for Let's Encrypt expiry notices (any inbox you check works —
# it does not need to be @zaa4eem.ru).
LETSENCRYPT_EMAIL=change-me@example.com

# --- Moderation ---
# Comma-separated extra banned words/phrases the owner wants filtered,
# on top of packages/shared/src/moderation/banned-words.ts.
ADMIN_EXTRA_BANNED_WORDS=

# --- Seed (first deploy only — see apps/api/prisma/seed.ts) ---
OWNER_TELEGRAM_ID=
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Misc ---
NODE_ENV=production
PORT=3001
