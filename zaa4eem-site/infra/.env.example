# Copy to infra/.env and fill in real values before running docker compose.
# NEVER commit the filled-in .env file (it's gitignored).

# --- Database ---
POSTGRES_USER=zaa4eem
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zaa4eem
DATABASE_URL=postgresql://zaa4eem:change-me@postgres:5432/zaa4eem

# --- Auth secrets (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=change-me

# --- Telegram ---
# From @BotFather. NEVER commit the real value.
TELEGRAM_BOT_TOKEN=change-me
# Public HTTPS origin(s) of apps/web. Comma-separated if you serve both the
# apex and www — the API's CORS check accepts any of these as the browser
# Origin header.
WEB_ORIGIN=https://zaa4eem.ru,https://www.zaa4eem.ru
# Single canonical URL for the Telegram Mini App button (apps/bot) — must be
# exactly one URL, unlike WEB_ORIGIN above.
MINI_APP_URL=https://zaa4eem.ru
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
# The one domain (no scheme, no trailing slash — e.g. "zaa4eem.ru", not
# "https://zaa4eem.ru/") apps/web's middleware.ts redirects every other
# host (www, in particular) to. Telegram's Login Widget and Google Sign-In
# both check the browser's exact origin against a single domain registered
# in BotFather / Google Cloud Console respectively — serving the site on
# both zaa4eem.ru AND www.zaa4eem.ru with no redirect between them means
# whichever one isn't registered gets a login button that silently fails.
# Must match whatever single domain you actually register with both.
CANONICAL_HOST=zaa4eem.ru

# --- Google Sign-In ---
# From https://console.cloud.google.com/apis/credentials — an OAuth 2.0
# "Web application" client. Add CANONICAL_HOST above (with https://) as an
# Authorized JavaScript origin; no redirect URI is needed (Google Identity
# Services returns the credential to the page directly, no server hop).
# Not a secret — the same public client ID is baked into the browser bundle
# below, so there's no separate GOOGLE_CLIENT_SECRET to configure here.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Frontend → API wiring ---
# The API lives on its own subdomain (see nginx-proxy routing below).
NEXT_PUBLIC_API_URL=https://api.zaa4eem.ru/api
# Same API host, but without the /api prefix — used server-side to build
# absolute URLs for uploaded files (e.g. avatars), which are served at
# /uploads/... rather than under /api.
API_PUBLIC_URL=https://api.zaa4eem.ru
# The site's own canonical URL — resolves the OG/Twitter share-card image
# to an absolute URL. Defaults to https://zaa4eem.ru if unset, so this only
# needs setting if the real domain ever changes.
NEXT_PUBLIC_SITE_URL=https://zaa4eem.ru
# The api service's own address *inside* the compose network — apps/bot
# calls this directly (e.g. to redeem a /link code) rather than looping
# back out through api.zaa4eem.ru. Defaults to the compose service name,
# so this only needs setting if you're running the bot outside compose.
API_INTERNAL_URL=http://api:3001

# --- nginx-proxy / acme-companion (existing reverse proxy on this VPS) ---
# Docker network name the existing `nginx-proxy` + `nginx-proxy-acme`
# containers are attached to — check with:
#   docker inspect nginx-proxy --format '{{json .NetworkSettings.Networks}}'
NGINX_PROXY_NETWORK=proxy
# Host(s) nginx-proxy should route to the `web` container. Comma-separated
# for apex + www; acme-companion will request one certificate covering both.
WEB_VIRTUAL_HOST=zaa4eem.ru,www.zaa4eem.ru
# Host nginx-proxy should route to the `api` container.
API_VIRTUAL_HOST=api.zaa4eem.ru
# Real email for Let's Encrypt expiry notices (any inbox you check works —
# it does not need to be @zaa4eem.ru).
LETSENCRYPT_EMAIL=change-me@example.com

# --- Email (password reset) ---
# Optional: if SMTP_HOST is unset, the API logs the reset link instead of
# emailing it (fine for local dev, not for production).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ZAA4EEM <no-reply@zaa4eem.ru>

# --- Moderation ---
# Comma-separated extra banned words/phrases the owner wants filtered,
# on top of packages/shared/src/moderation/banned-words.ts.
ADMIN_EXTRA_BANNED_WORDS=

# --- Seed (first deploy only — see apps/api/prisma/seed.ts) ---
OWNER_TELEGRAM_ID=
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Digest ---
# Telegram chat id (not a channel) the owner's 3-day activity summary is
# DM'd to — DigestService skips sending entirely if this is unset. Get your
# own numeric id from @userinfobot on Telegram.
DIGEST_CHAT_ID=

# --- Web Push (браузерные уведомления) ---
# VAPID key pair identifying this server to the browsers' push services.
# Generate once with:
#   npx web-push generate-vapid-keys
# Both keys must stay the same forever: rotating them silently invalidates
# every existing subscription, and each affected browser has to opt in
# again. Leave them unset to run without push — the API logs "Web push
# disabled" and the frontend hides the push toggle instead of offering a
# switch that can't work. The public key is served to browsers by
# GET /api/notifications/push/public-key; the private one is a secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services can reach you at if a subscription
# misbehaves. Must be a mailto: or https: URL.
VAPID_SUBJECT=mailto:change-me@example.com

# --- Backups (infra/backup.sh — see infra/BACKUPS.md) ---
# Optional. Set this to encrypt each pg_dump at rest (AES-256, via gpg) —
# a dump contains every user's password hash and email in plain SQL
# otherwise. Leave unset to keep the existing unencrypted behavior (the
# dump file and its containing directory are still locked down to
# owner-only regardless). Generate one with: openssl rand -base64 32
BACKUP_ENCRYPTION_PASSPHRASE=

# --- Misc ---
NODE_ENV=production
PORT=3001
