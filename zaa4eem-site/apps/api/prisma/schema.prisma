generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  SUBSCRIBER
}

enum UserStatus {
  ACTIVE
  MUTED
  BANNED
}

enum IdeaStatus {
  NEW
  UNDER_REVIEW
  ACCEPTED
  IN_PROGRESS
  SHIPPED
  DECLINED
}

enum PremiumNameStyle {
  FLOW
  HOLO
  GLOW
}

enum PremiumRingStyle {
  SPIN
  PULSE
  GLOW
  RAINBOW
  VENOM
}

enum PremiumNameFont {
  SPACE
  SERIF
  PIXEL
}

enum ModerationState {
  CLEAN
  PENDING_REVIEW
  APPROVED
  REMOVED
}

enum ScoreReviewState {
  NORMAL
  HELD_FOR_REVIEW
}

/// Every kind of single-use link we email. One model, one table, one expiry sweep.
enum EmailTokenType {
  /// Proves the address belongs to whoever is holding the inbox.
  VERIFY_EMAIL
  /// Passwordless sign-in: the link itself is the credential.
  MAGIC_LINK
}

enum ModerationTargetType {
  IDEA
  POST
  USER
  SCORE
}

model User {
  id                String     @id @default(uuid())
  memberNumber      Int        @unique @default(autoincrement())
  role              UserRole   @default(SUBSCRIBER)
  status            UserStatus @default(ACTIVE)
  displayName       String
  avatarUrl         String?
  bio               String?
  statusText        String?
  telegramId        BigInt?    @unique
  telegramUsername  String?
  googleId          String?    @unique
  email             String?    @unique
  passwordHash      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Premium-only cosmetic (ProfileService.uploadBanner) — shown behind the
  // avatar on the public profile header. bannerUrl persists even if Premium
  // later lapses (matches how nameStyle/ringStyle etc. already work); it
  // just stops being *settable* until Premium is active again.
  bannerUrl         String?
  // Last time this user's browser sent a heartbeat (any click/keypress/tap)
  // — drives the online/away/offline presence indicator, computed lazily
  // from this timestamp (see common/presence.util.ts) rather than stored as
  // an enum, so it's never stale.
  lastActiveAt      DateTime?

  // Premium cosmetics — granted either by the owner (admin panel) or
  // self-service via the Z-Coin shop (ShopService.buyPremium). Either path
  // just flips isPremium; the style fields below are always the user's own
  // choice afterwards (see /settings' PremiumStyleFields). nameColor is
  // only meaningful when nameStyle is GLOW; FLOW/HOLO compute their colors
  // from the viewer's theme instead (see the frontend's premium styles).
  isPremium         Boolean           @default(false)
  nameStyle         PremiumNameStyle?
  nameColor         String?
  ringStyle         PremiumRingStyle?
  badgeEmoji        String?
  nameFont          PremiumNameFont?

  // Z-Coin clicker economy (ClickerService). No offline/idle production —
  // coinsEarnedToday + coinsEarnedDay enforce a per-UTC-day earn cap on
  // manual clicks only; clickPower is raised by repeatable upgrades.
  zCoins            Int       @default(0)
  clickPower        Int       @default(1)
  coinsEarnedToday  Int       @default(0)
  coinsEarnedDay    DateTime?

  // Referrals: every user gets a permanent random code (never the guessable
  // memberNumber) for their personal invite link. invitedById is set only
  // once, at the invitee's first-ever registration (bot /start ref_CODE or
  // web /r/CODE) — never reassigned retroactively. usedTrialPremium caps the
  // one-time 24h Premium taste (first successful referral, or the Shop's
  // standalone "try free" button — whichever happens first) to once ever.
  // premiumUntil is the other half of that: null + isPremium means granted
  // forever (owner grant, or admin picks "Навсегда"), a date means it lazily
  // expires next time ensurePremiumFresh() sees this row (ClickerService's
  // ensureFreshDay is the same lazy-check pattern, applied here to Premium).
  referralCode      String    @unique
  invitedById       String?
  invitedBy         User?     @relation("Referrals", fields: [invitedById], references: [id])
  referrals         User[]    @relation("Referrals")
  premiumUntil      DateTime?
  usedTrialPremium  Boolean   @default(false)

  // Notification preferences. Separate columns rather than a JSON blob so
  // the sender can filter recipients in the query itself instead of loading
  // every candidate and checking in JS. All default to on: a brand-new
  // account should hear about things happening to it, and turning any of
  // them off is one toggle away in Settings.
  notifyLikes       Boolean   @default(true)
  notifyComments    Boolean   @default(true)
  notifyFollows     Boolean   @default(true)
  notifyIdeas       Boolean   @default(true)
  notifyRecords     Boolean   @default(true)
  /// Master switch for browser/phone push. The in-app bell is always on — it's just a list, it can't interrupt anyone.
  notifyPush        Boolean   @default(true)
  /// Telegram DMs, for accounts that linked Telegram. Was previously unconditional.
  notifyTelegram    Boolean   @default(true)

  // --- Security ---
  /// When the address on this account was proven to belong to whoever holds
  /// the inbox. null = never proven. Accounts created before verification
  /// existed are backfilled to their createdAt by the migration: they are
  /// grandfathered, not silently downgraded.
  emailVerifiedAt   DateTime?
  /// Base32 TOTP secret. Only meaningful once totpEnabledAt is set — the
  /// secret is generated at the start of enrolment and is worthless until
  /// the user proves they can read a code from it.
  totpSecret        String?
  totpEnabledAt     DateTime?

  posts             Post[]
  ideas             Idea[]
  votes             Vote[]
  scores            Score[]
  likes             Like[]
  comments          Comment[]
  refreshTokens     RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  telegramLinkCodes TelegramLinkCode[]
  pendingReferrals  PendingReferral[]
  ideaCredits       IdeaCredit[]
  moderationActions ModerationLogEntry[] @relation("ModerationActor")
  following         Follow[]             @relation("Follower")
  followers         Follow[]             @relation("Following")
  notifications     Notification[]       @relation("NotificationRecipient")
  notificationsCaused Notification[]     @relation("NotificationActor")
  pushSubscriptions PushSubscription[]
  progress          UserProgress?
  achievements      AchievementUnlock[]
  dailyQuests       DailyQuestProgress[]
  seasonScores      SeasonScore[]
  rewardClaims      RewardClaim[]
  emailTokens       EmailToken[]
  credentials       WebAuthnCredential[]
  backupCodes       BackupCode[]

  @@index([role])
  @@index([invitedById])
  // Serves the Z-Кликер leaderboard's `where: zCoins > 0, orderBy: zCoins desc`.
  @@index([zCoins])
}

// The owner manually crediting someone's real-world (outside-the-app) idea
// that shipped as a feature — separate from the in-app Idea board, which is
// self-service voting/submission. Shows as a badge on the credited user's
// profile, linking to the public /hall-of-fame list.
model IdeaCredit {
  id          String   @id @default(uuid())
  creditedId  String
  credited    User     @relation(fields: [creditedId], references: [id], onDelete: Cascade)
  description String
  createdAt   DateTime @default(now())

  @@index([creditedId])
}

// Bridges the gap between "someone clicked a Telegram referral deep-link"
// and "that Telegram identity actually became an account" — /start fires
// (and the referral must be captured) before any User row for that
// telegramId exists yet. Consumed and deleted the moment that first
// Mini App login creates the account; a code silently expiring unused
// (never opens the Mini App) never needs cleanup beyond FK cascade.
model PendingReferral {
  telegramId BigInt   @id
  referrerId String
  referrer   User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  // Cover getFollowers'/getFollowing's (createdAt desc, id desc) cursor sort.
  @@index([followingId, createdAt, id])
  @@index([followerId, createdAt, id])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  /// Device metadata, so "Сеансы" in Settings can show something a person
  /// recognises instead of a row of opaque ids. Nullable because sessions
  /// created before this existed have none, and because a client is free
  /// not to send a User-Agent.
  userAgent  String?
  /// Truncated to a /24 (IPv4) or /48 (IPv6) before storing — enough to say
  /// "a different network", never a precise location log.
  ipPrefix   String?
  /// Human-readable, derived from userAgent at issue time ("Chrome, Windows").
  deviceLabel String?
  lastUsedAt DateTime?

  @@index([userId])
  /// Serves the sessions list's `where userId, revokedAt: null order by lastUsedAt desc`.
  @@index([userId, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One-account-everywhere: a short-lived 6-digit code a logged-in browser
// session generates (Settings → "Привязать Telegram"), then redeems by
// sending /link <code> to the bot — links the bot's telegramId to this
// user without needing initData (only available inside the Mini App
// WebView, not from a Telegram chat command).
model TelegramLinkCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Post {
  id              String          @id @default(uuid())
  authorId        String
  author          User            @relation(fields: [authorId], references: [id])
  body            String
  imageUrl        String?
  moderationState ModerationState @default(CLEAN)
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  likes           Like[]
  comments        Comment[]

  @@index([publishedAt])
  @@index([moderationState])
  @@index([authorId, createdAt])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id              String          @id @default(uuid())
  postId          String
  post            Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId        String
  author          User            @relation(fields: [authorId], references: [id])
  body            String
  moderationState ModerationState @default(CLEAN)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([postId, createdAt])
  @@index([moderationState])
}

model Idea {
  id               String          @id @default(uuid())
  submitterId      String
  submitter        User            @relation(fields: [submitterId], references: [id])
  title            String
  description      String
  status           IdeaStatus      @default(NEW)
  moderationState  ModerationState @default(CLEAN)
  voteCount        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  votes            Vote[]

  @@index([status])
  @@index([moderationState])
  @@index([voteCount])
  // Cover the ideas board's "top"/"new" tabs — filter by moderationState,
  // sort by voteCount or createdAt.
  @@index([moderationState, voteCount])
  @@index([moderationState, createdAt])
}

model Vote {
  id        String   @id @default(uuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ideaId, userId])
}

model Game {
  id                String   @id @default(uuid())
  slug              String   @unique
  title             String
  description       String
  thumbnailUrl      String?
  maxPlausibleScore Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  scores            Score[]
}

model Score {
  id           String            @id @default(uuid())
  gameId       String
  game         Game              @relation(fields: [gameId], references: [id])
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  value        Int
  reviewState  ScoreReviewState  @default(NORMAL)
  createdAt    DateTime          @default(now())

  @@index([gameId, userId])
  @@index([gameId, value])
  // Cover leaderboard/profile/digest queries filtering by reviewState.
  @@index([gameId, reviewState, value])
  @@index([userId, reviewState])
}

model ModerationLogEntry {
  id         String               @id @default(uuid())
  actorId    String
  actor      User                 @relation("ModerationActor", fields: [actorId], references: [id])
  targetType ModerationTargetType
  targetId   String
  action     String
  reason     String?
  createdAt  DateTime             @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// What kind of thing happened. Kept as an enum rather than free text so the

// frontend can render each one its own way (icon, wording, where tapping it

// goes) without parsing strings.
enum NotificationType {
  POST_LIKED
  POST_COMMENTED
  NEW_FOLLOWER
  IDEA_STATUS_CHANGED
  IDEA_VOTED
  RECORD_BEATEN
  PREMIUM_GRANTED
  SYSTEM
}

// One entry in a user's notification feed.

//

// Before this existed the only notification channel was a fire-and-forget

// Telegram DM, which meant no history, no unread count, and nothing at all

// for the majority of users who signed up with an email address.

//

// `actorId` is who caused it (null for system messages), and the

// targetType/targetId pair is a loose reference to whatever the

// notification is about — deliberately not a foreign key, so deleting a

// post doesn't cascade away the record that it was once liked.
model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  actorId    String?
  actor      User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetType String?
  targetId   String?
  /// Pre-rendered Russian text — the wording is decided once, at creation, so old notifications don't silently change meaning when the copy is reworded.
  body       String
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  // Covers both the feed query (newest first for one user) and the unread
  // badge count, which is the same filter plus readAt IS NULL.
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// A browser/device that agreed to receive Web Push. One user can have

// several (phone, laptop, work machine). `endpoint` is the push service's

// own URL and is unique per subscription — re-subscribing on the same

// device returns the same endpoint, so it doubles as the identity.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Retention: levels, streaks, quests, achievements, seasons.
// ---------------------------------------------------------------------------

/// Everything that only goes up, in its own row rather than a dozen more
/// columns on User. Created lazily the first time a user does anything
/// countable, so accounts that predate this feature need no backfill.
model UserProgress {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Lifetime XP. `level` is derived from it (levelFromXp) but stored too,
  /// so leaderboards and achievement checks can sort/filter in SQL.
  xp                Int       @default(0)
  level             Int       @default(1)

  /// Consecutive days with a visit. lastStreakDay is UTC midnight of the
  /// most recent counted day, which is what makes the check idempotent —
  /// a hundred requests on the same day advance nothing.
  streakDays        Int       @default(0)
  streakBest        Int       @default(0)
  lastStreakDay     DateTime?
  /// When Premium last forgave a missed day, so the freeze can have a cooldown.
  freezeUsedAt      DateTime?

  // Lifetime counters — the raw material every achievement is measured against.
  postsPublished    Int       @default(0)
  commentsWritten   Int       @default(0)
  likesReceived     Int       @default(0)
  likesGiven        Int       @default(0)
  ideasSubmitted    Int       @default(0)
  ideasAccepted     Int       @default(0)
  ideaVotesCast     Int       @default(0)
  gamesPlayed       Int       @default(0)
  followersGained   Int       @default(0)
  followsMade       Int       @default(0)
  coinsEarnedTotal  Int       @default(0)
  referralsJoined   Int       @default(0)
  daysActive        Int       @default(0)

  /// The 5-step newcomer quest pays 24h of Premium exactly once.
  onboardingDone    Boolean   @default(false)
  onboardingClaimed Boolean   @default(false)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  /// Serves the level leaderboard.
  @@index([xp])
}

/// One row per achievement a user has earned. The catalogue itself lives in
/// code (packages/shared/src/progress/achievements.ts) — only the unlock is
/// data, so adding an achievement never needs a migration.
model AchievementUnlock {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  unlockedAt DateTime @default(now())

  @@unique([userId, code])
  @@index([userId, unlockedAt])
}

/// Progress on one of today's three quests. The assignment itself is
/// computed (questsForDay), so a row only appears once there is progress
/// to record.
model DailyQuestProgress {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// UTC midnight of the day this belongs to.
  day       DateTime
  code      String
  progress  Int       @default(0)
  claimedAt DateTime?

  @@unique([userId, day, code])
  @@index([userId, day])
}

/// XP earned inside one season. Season boundaries are computed from the
/// calendar (seasonAt), so nothing has to create or close a season.
model SeasonScore {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Int
  xp     Int    @default(0)

  @@unique([userId, season])
  /// Serves the season leaderboard's `where season = ? order by xp desc`.
  @@index([season, xp])
}

/// One-off rewards that must never pay twice — referral goals today, and
/// anything else with a "claimed" state later. Kept separate from
/// AchievementUnlock because these carry a payout, not just a badge.
model RewardClaim {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  claimedAt DateTime @default(now())

  @@unique([userId, code])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Security: email proof, passkeys, 2FA.
// ---------------------------------------------------------------------------

/// A single-use emailed link. Only the hash is stored, exactly like a refresh
/// token: a leaked database must not hand out working sign-in links.
model EmailToken {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique
  /// The address it was actually sent to — a verification link must not
  /// verify an address the user changed to something else after requesting it.
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

/// A registered passkey. publicKey is the COSE key as raw bytes; nothing here
/// is secret on its own — a passkey's private half never leaves the device.
model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// base64url, as the browser reports it.
  credentialId String    @unique
  publicKey    Bytes
  /// Replay guard: an authenticator that supports it must never present a
  /// counter lower than the one we last saw.
  counter      Int       @default(0)
  transports   String?
  /// What the user called it, or a guess from the User-Agent at registration.
  label        String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// A WebAuthn challenge in flight. Server-side and single-use, because the
/// whole protocol rests on the server having chosen the challenge.
model WebAuthnChallenge {
  id        String   @id @default(uuid())
  /// null during a passkey *login*, where the user is not yet identified —
  /// that is the point of a discoverable credential.
  userId    String?
  challenge String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// One-time 2FA recovery code. Hashed, so the list shown once at generation
/// time is genuinely the only copy the user will ever get.
model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
