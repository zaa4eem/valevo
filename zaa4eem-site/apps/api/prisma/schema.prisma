generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  SUBSCRIBER
}

enum UserStatus {
  ACTIVE
  MUTED
  BANNED
}

enum IdeaStatus {
  NEW
  UNDER_REVIEW
  ACCEPTED
  IN_PROGRESS
  SHIPPED
  DECLINED
}

enum PremiumNameStyle {
  FLOW
  HOLO
  GLOW
}

enum PremiumRingStyle {
  SPIN
  PULSE
}

enum ModerationState {
  CLEAN
  PENDING_REVIEW
  APPROVED
  REMOVED
}

enum ScoreReviewState {
  NORMAL
  HELD_FOR_REVIEW
}

enum ModerationTargetType {
  IDEA
  POST
  USER
  SCORE
}

model User {
  id                String     @id @default(uuid())
  memberNumber      Int        @unique @default(autoincrement())
  role              UserRole   @default(SUBSCRIBER)
  status            UserStatus @default(ACTIVE)
  displayName       String
  avatarUrl         String?
  bio               String?
  statusText        String?
  telegramId        BigInt?    @unique
  telegramUsername  String?
  email             String?    @unique
  passwordHash      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Premium cosmetics — owner-granted only, never self-service. nameColor is
  // only meaningful when nameStyle is GLOW; FLOW/HOLO compute their colors
  // from the viewer's theme instead (see the frontend's premium styles).
  isPremium         Boolean           @default(false)
  nameStyle         PremiumNameStyle?
  nameColor         String?
  ringStyle         PremiumRingStyle?
  badgeEmoji        String?

  posts             Post[]
  ideas             Idea[]
  votes             Vote[]
  scores            Score[]
  likes             Like[]
  comments          Comment[]
  refreshTokens     RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  moderationActions ModerationLogEntry[] @relation("ModerationActor")
  following         Follow[]             @relation("Follower")
  followers         Follow[]             @relation("Following")

  @@index([role])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Post {
  id              String          @id @default(uuid())
  authorId        String
  author          User            @relation(fields: [authorId], references: [id])
  body            String
  moderationState ModerationState @default(CLEAN)
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  likes           Like[]
  comments        Comment[]

  @@index([publishedAt])
  @@index([moderationState])
  @@index([authorId, createdAt])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id              String          @id @default(uuid())
  postId          String
  post            Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId        String
  author          User            @relation(fields: [authorId], references: [id])
  body            String
  moderationState ModerationState @default(CLEAN)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([postId, createdAt])
  @@index([moderationState])
}

model Idea {
  id               String          @id @default(uuid())
  submitterId      String
  submitter        User            @relation(fields: [submitterId], references: [id])
  title            String
  description      String
  status           IdeaStatus      @default(NEW)
  moderationState  ModerationState @default(CLEAN)
  voteCount        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  votes            Vote[]

  @@index([status])
  @@index([moderationState])
  @@index([voteCount])
}

model Vote {
  id        String   @id @default(uuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ideaId, userId])
}

model Game {
  id                String   @id @default(uuid())
  slug              String   @unique
  title             String
  description       String
  thumbnailUrl      String?
  maxPlausibleScore Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  scores            Score[]
}

model Score {
  id           String            @id @default(uuid())
  gameId       String
  game         Game              @relation(fields: [gameId], references: [id])
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  value        Int
  reviewState  ScoreReviewState  @default(NORMAL)
  createdAt    DateTime          @default(now())

  @@index([gameId, userId])
  @@index([gameId, value])
}

model ModerationLogEntry {
  id         String               @id @default(uuid())
  actorId    String
  actor      User                 @relation("ModerationActor", fields: [actorId], references: [id])
  targetType ModerationTargetType
  targetId   String
  action     String
  reason     String?
  createdAt  DateTime             @default(now())

  @@index([targetType, targetId])
}
